#!/usr/bin/env python3
"""
Update Nginx site configs only for the tailnet already declared in appliance settings.
The optional argument must match that declaration; change the setting through Caduceus.
"""
import json
import re
import subprocess
import sys
import shutil
import glob
import os
import time
from pathlib import Path
from typing import Optional, List, Tuple

# Configuration
NGINX_SITES_DIR = "/etc/nginx/sites-available"
APPLIANCE_CONFIG = "/etc/appliance/config.json"
BACKUP_DIR = "/etc/nginx/sites-available/backup"

def check_nginx_running() -> bool:
    """Check if nginx is running."""
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', 'is-active', '--quiet', 'nginx'],
            check=False
        )
        return result.returncode == 0
    except Exception as e:
        print(f"Error checking nginx status: {e}")
        return False

def get_declared_tailnet() -> Optional[str]:
    """Extract the declared tailnet from the canonical appliance config."""
    try:
        with open(APPLIANCE_CONFIG, 'r') as f:
            config = json.load(f)
        global_config = config.get('global', {}) if isinstance(config, dict) else {}
        cors = global_config.get('cors', {}) if isinstance(global_config, dict) else {}
        origins = cors.get('allowed_origins', []) if isinstance(cors, dict) else []
        if not isinstance(origins, list):
            return None
        for origin in origins:
            if isinstance(origin, str):
                match = re.search(r'https://home[.]([a-zA-Z0-9-]+)[.]ts[.]net', origin)
                if match:
                    return match.group(1)
        return None
    except (OSError, json.JSONDecodeError):
        print("Error reading canonical appliance config.")
        return None

def find_homeserver_files() -> List[str]:
    """Find all homeserver-* files in nginx sites-available directory."""
    pattern = f"{NGINX_SITES_DIR}/homeserver-*"
    files = glob.glob(pattern)
    return [f for f in files if Path(f).is_file()]

def get_current_tailnet_from_file(file_path: str) -> Optional[str]:
    """Get current tailnet name from a specific nginx config file."""
    try:
        with open(file_path, 'r') as f:
            content = f.read()
            match = re.search(r'home\.([a-zA-Z0-9-]+)\.ts\.net', content)
            return match.group(1) if match else None
    except Exception as e:
        print(f"Error reading nginx config {file_path}: {e}")
        return None

def update_nginx_config_file(file_path: str, new_tailnet: str) -> bool:
    """Update a single nginx config file with new tailnet name."""
    try:
        with open(file_path, 'r') as f:
            content = f.read()
        
        # Replace any existing tailnet pattern with the new one
        new_content = re.sub(
            r'home\.[a-zA-Z0-9-]+\.ts\.net',
            f'home.{new_tailnet}.ts.net',
            content
        )
        
        with open(file_path, 'w') as f:
            f.write(new_content)
        return True
    except Exception as e:
        print(f"Error updating nginx config {file_path}: {e}")
        return False

def create_backup_directory() -> bool:
    """Create backup directory if it doesn't exist."""
    try:
        Path(BACKUP_DIR).mkdir(parents=True, exist_ok=True)
        return True
    except Exception as e:
        print(f"Error creating backup directory: {e}")
        return False

def backup_file(file_path: str) -> bool:
    """Create backup of a single file."""
    try:
        filename = Path(file_path).name
        backup_path = f"{BACKUP_DIR}/{filename}.bak"
        shutil.copy2(file_path, backup_path)
        return True
    except Exception as e:
        print(f"Failed to create backup for {file_path}: {e}")
        return False

def restore_file(file_path: str) -> bool:
    """Restore a single file from backup."""
    try:
        filename = Path(file_path).name
        backup_path = f"{BACKUP_DIR}/{filename}.bak"
        if Path(backup_path).exists():
            shutil.copy2(backup_path, file_path)
            return True
        return False
    except Exception as e:
        print(f"Failed to restore {file_path}: {e}")
        return False

def test_nginx_config() -> bool:
    """Test nginx configuration."""
    try:
        result = subprocess.run(
            ['/usr/sbin/nginx', '-t'],
            capture_output=True,
            text=True,
            check=False
        )
        if result.returncode != 0:
            print(f"Nginx configuration test failed:")
            print(result.stderr)
            if result.stdout:
                print(result.stdout)
        return result.returncode == 0
    except Exception as e:
        print(f"Error testing nginx config: {e}")
        return False

def restart_nginx() -> bool:
    """Restart nginx service."""
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', 'restart', 'nginx'],
            check=False
        )
        return result.returncode == 0
    except Exception as e:
        print(f"Error restarting nginx: {e}")
        return False

def restart_gunicorn() -> bool:
    """Restart gunicorn service using systemd one-shot to escape context."""
    SERVICE_NAME = "restart-gunicorn-oneshot.service"
    SERVICE_PATH = f"/etc/systemd/system/{SERVICE_NAME}"
    
    SERVICE_CONTENT = """[Unit]
Description=Restart Gunicorn Service (One-Shot)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart gunicorn.service
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
"""
    
    try:
        # Write service file
        with open(SERVICE_PATH, 'w') as f:
            f.write(SERVICE_CONTENT)
        
        # Reload systemd
        result = subprocess.run(
            ['/usr/bin/systemctl', 'daemon-reload'],
            capture_output=True,
            text=True,
            check=False
        )
        if result.returncode != 0:
            print(f"Failed to reload systemd: {result.stderr}")
            return False
        
        # Start the one-shot service
        result = subprocess.run(
            ['/usr/bin/systemctl', 'start', SERVICE_NAME],
            capture_output=True,
            text=True,
            check=False
        )
        if result.returncode != 0:
            print(f"Failed to start oneshot service: {result.stderr}")
            # Clean up on failure
            try:
                os.remove(SERVICE_PATH)
                subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=False)
            except:
                pass
            return False
        
        # Give gunicorn a moment to restart
        time.sleep(2)
        
        # Verify gunicorn is running
        result = subprocess.run(
            ['/usr/bin/systemctl', 'is-active', '--quiet', 'gunicorn.service'],
            check=False
        )
        if result.returncode != 0:
            print("Warning: Gunicorn restart initiated but service may not be active yet")
            return False
        
        # Clean up service file
        try:
            os.remove(SERVICE_PATH)
            subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=False)
        except:
            pass  # Non-critical cleanup failure
        
        return True
    except Exception as e:
        print(f"Error restarting gunicorn: {e}")
        # Clean up on error
        try:
            if os.path.exists(SERVICE_PATH):
                os.remove(SERVICE_PATH)
                subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=False)
        except:
            pass
        return False

def regenerate_ssl_certificate() -> bool:
    """Regenerate SSL certificate with new tailnet name."""
    try:
        result = subprocess.run(
            ['/usr/local/sbin/sslKey.sh'],
            capture_output=True,
            text=True,
            check=False
        )
        if result.returncode != 0:
            print(f"SSL certificate regeneration failed (exit code {result.returncode}):")
            if result.stderr:
                print(f"Error: {result.stderr}")
            if result.stdout:
                print(f"Output: {result.stdout}")
            return False
        print("SSL certificate regenerated successfully with new tailnet")
        if result.stdout:
            print(result.stdout)
        return True
    except Exception as e:
        print(f"Error regenerating SSL certificate: {e}")
        return False

def main() -> int:
    """Update retained Nginx/certificate surfaces for the declared tailnet."""
    if len(sys.argv) > 2:
        print("Usage: tailnetName [tailnet_name]")
        return 2

    declared_tailnet = get_declared_tailnet()
    if not declared_tailnet:
        print("Could not determine the declared tailnet from appliance config.")
        return 2

    if len(sys.argv) == 2:
        requested_tailnet = sys.argv[1]
        if not re.fullmatch(r'[a-zA-Z0-9-]+', requested_tailnet):
            print("Invalid tailnet name format.")
            print("Tailnet name must contain only letters, numbers, and hyphens.")
            return 2
        if requested_tailnet != declared_tailnet:
            print("Requested tailnet differs from the value declared in appliance config.")
            print("Change the tailnet through Caduceus settings; no certificate, Nginx, or service work was performed.")
            return 2
        new_tailnet = requested_tailnet
        print("Using the tailnet already declared in appliance config.")
    else:
        new_tailnet = declared_tailnet
        print("Detected tailnet from appliance config.")

    # Reject a different requested value before any Nginx, certificate, or service work.
    if not check_nginx_running():
        print("Nginx is not running. Exiting.")
        return 1

    # Find all homeserver files
    homeserver_files = find_homeserver_files()
    if not homeserver_files:
        print("No homeserver-* files found in nginx sites-available directory.")
        return 3

    print(f"Found {len(homeserver_files)} homeserver files to update:")
    for file_path in homeserver_files:
        print(f"  - {Path(file_path).name}")

    # Check if any files need updating by looking for any existing tailnet pattern
    needs_update = False
    for file_path in homeserver_files:
        with open(file_path, 'r') as f:
            content = f.read()
            if re.search(r'home\.[a-zA-Z0-9-]+\.ts\.net', content):
                needs_update = True
                break
    
    if not needs_update:
        print("No tailnet patterns found in nginx config files. No update needed.")
        return 0

    print(f"Updating all tailnet patterns to '{new_tailnet}'")

    # Create backup directory
    if not create_backup_directory():
        return 5

    # Backup all files
    print("Creating backups...")
    for file_path in homeserver_files:
        if not backup_file(file_path):
            print(f"Failed to backup {file_path}. Exiting.")
            return 6

    # STEP 1: Regenerate SSL certificate FIRST (before nginx changes)
    # This ensures the certificate exists with proper permissions before nginx tries to use it
    print("Regenerating SSL certificate with new tailnet (must happen before nginx restart)...")
    if not regenerate_ssl_certificate():
        print("SSL certificate regeneration failed. Exiting without making changes.")
        return 8

    # STEP 2: Update nginx config files
    print("Updating nginx configuration files...")
    updated_files = []
    for file_path in homeserver_files:
        if update_nginx_config_file(file_path, new_tailnet):
            updated_files.append(file_path)
            print(f"  ✓ Updated {Path(file_path).name}")
        else:
            print(f"  ✗ Failed to update {Path(file_path).name}")
            # Rollback all updated files
            print("Rolling back all changes...")
            for updated_file in updated_files:
                restore_file(updated_file)
            return 7

    # STEP 3: Test nginx config (certificate now exists, configs updated)
    print("Testing nginx configuration...")
    if not test_nginx_config():
        print("New nginx configuration is invalid. Rolling back all changes...")
        for file_path in homeserver_files:
            restore_file(file_path)
        return 8

    # STEP 4: Restart nginx (certificate exists, configs valid)
    print("Restarting nginx...")
    if not restart_nginx():
        print("Failed to restart nginx. Rolling back all changes...")
        for file_path in homeserver_files:
            restore_file(file_path)
        if not restart_nginx():
            print("Failed to restart nginx even after revert! Manual intervention required.")
            return 10
        print("Nginx reverted and restarted successfully.")
        return 9

    print(f"Nginx restarted successfully with new tailnet: {new_tailnet}")
    print(f"Updated {len(homeserver_files)} files:")
    for file_path in homeserver_files:
        print(f"  - {Path(file_path).name}")
    
    # STEP 5: Retain the existing gunicorn restart after the Nginx update
    print("Restarting gunicorn after the Nginx update...")
    if not restart_gunicorn():
        print("Warning: Failed to restart gunicorn; a manual service restart may be needed.")
        print("You may need to manually restart gunicorn: systemctl restart gunicorn.service")
        # Don't fail the script - nginx and configs are updated, gunicorn restart is nice-to-have
    else:
        print("Gunicorn restarted successfully.")
    
    return 0

if __name__ == '__main__':
    sys.exit(main())
