#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'caduceus-staff-root-required' >&2; exit 77; }
PYTHON=${CADUCEUS_STAFF_PYTHON:-/var/lib/caduceus/venv/bin/python3}
[ -x "$PYTHON" ] || PYTHON=python3
STAFF_SHELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONPATH="$STAFF_SHELF"
exec "$PYTHON" -m agathodaimon.source_map reseed
