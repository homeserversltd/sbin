#!/bin/bash
# tailget - Extract the declared tailnet from the canonical appliance config.
# Usage: ./tailget

set -e
CONFIG_JSON="/etc/appliance/config.json"

if [ "$#" -ne 0 ]; then
    echo "Usage: tailget (reads /etc/appliance/config.json)" >&2
    exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required but not installed" >&2
    exit 1
fi

if [ ! -f "$CONFIG_JSON" ]; then
    echo "Error: canonical appliance config is missing at /etc/appliance/config.json" >&2
    exit 1
fi

if ! jq -e 'type == "object" and (.global | type == "object")' "$CONFIG_JSON" >/dev/null 2>&1; then
    echo "Error: canonical appliance config has no valid global object" >&2
    exit 1
fi

# Extract tailnet from CORS allowed_origins (primary source).
echo "Checking declared allowed origins..." >&2
tailnet=$(jq -r '.global.cors.allowed_origins[]?' "$CONFIG_JSON" | grep -o 'home\.[a-zA-Z0-9-]*\.ts\.net' | head -n1 | cut -d. -f2 || true)

if [[ -z "$tailnet" ]]; then
    echo "Error: no declared tailnet could be determined from appliance config" >&2
    exit 1
fi

printf '%s\n' "$tailnet"
