#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON=${AGATHODAIMON_PYTHON:-/var/lib/caduceus/venv/bin/python3}
[ -x "$PYTHON" ] || PYTHON=python3
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
case "${1-}" in reservations) [ "${2-}" = list ] && set -- reservations || true ;; boundary) [ "${2-}" = show ] && set -- boundary || true ;; esac
exec "$PYTHON" "$ROOT/agathodaimon/cli.py" network dhcp "$@"
