#!/bin/sh
set -eu
STAFF_SHELF=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONPATH="$STAFF_SHELF${PYTHONPATH:+:$PYTHONPATH}"
[ "$(id -u)" -eq 0 ] || { echo 'caduceus-staff-root-required' >&2; exit 77; }
exec "${CADUCEUS_STAFF_PYTHON:-/var/lib/caduceus/venv/bin/python3}" -m agathodaimon.bind_derived bind
